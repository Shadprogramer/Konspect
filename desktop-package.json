{
  "name": "mozgohran",
  "version": "1.0.0",
  "description": "Мозгохран: конспекты по учебникам",
  "main": "main.js",
  "author": "Vlad",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.vlad.konspekty.desktop",
    "productName": "Мозгохран",
    "artifactName": "Mozgohran-Setup-${version}.exe",
    "files": ["main.js", "index.html", "icon.png"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
